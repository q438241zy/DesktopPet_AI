<Project>
  <PropertyGroup>
    <!-- The user controls the major number; each delivered update advances the minor number. -->
    <DesktopPetMajor>1</DesktopPetMajor>
    <DesktopPetMinor>6</DesktopPetMinor>
    <Version>$(DesktopPetMajor).$(DesktopPetMinor).0</Version>
    <AssemblyVersion>$(DesktopPetMajor).$(DesktopPetMinor).0.0</AssemblyVersion>
    <FileVersion>$(DesktopPetMajor).$(DesktopPetMinor).0.0</FileVersion>
    <InformationalVersion>$(DesktopPetMajor).$(DesktopPetMinor)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
